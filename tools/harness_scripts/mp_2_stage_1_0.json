{
 "version": 1,
 "comment": "opening.json up to the player count, the 2-player game, stage 1-0, each pad walks (needs ?gba=2)",
 "steps": [
  {
   "comment": "0: boot loader until the title (mode 1)",
   "wait": {
    "mode": 1
   },
   "timeout": 3000
  },
  {
   "comment": "1: title: START until the main menu (mode 2)",
   "press": [
    "START"
   ],
   "every": 30,
   "until": {
    "mode": 2
   },
   "timeout": 1200
  },
  {
   "comment": "2: main menu: A on Hyrulean Adventure, then A on its START! button, until the file select (mode 3)",
   "press": [
    "A"
   ],
   "every": 30,
   "until": {
    "mode": 3
   },
   "timeout": 1200
  },
  {
   "comment": "3: file select: wait for the 'create a file for this game on the Memory Card in Slot A?' prompt (state 7)",
   "wait": {
    "lbl_8053ADB0->mState": 7
   },
   "timeout": 1200
  },
  {
   "comment": "4: move its cursor to Yes (field_0x114 0)",
   "press": [
    "LEFT"
   ],
   "every": 10,
   "until": {
    "lbl_8053ADB0->field_0x114": 0
   },
   "timeout": 300
  },
  {
   "comment": "5: A on Yes: state 8 writes the file, state 9 waits for the card",
   "press": [
    "A"
   ],
   "every": 10,
   "until": {
    "lbl_8053ADB0->mState": [
     8,
     9,
     10
    ]
   },
   "timeout": 300
  },
  {
   "comment": "6: until the card write is done ('file created' message, state 10)",
   "wait": {
    "lbl_8053ADB0->mState": 10
   },
   "timeout": 3000
  },
  {
   "comment": "7: the message closes by itself; wait for the file rows (state 5, picking a file)",
   "wait": {
    "lbl_8053ADB0->mState": 5
   },
   "timeout": 1200
  },
  {
   "comment": "8: A on file 1, then A on its menu, until the stage loader (mode 4)",
   "press": [
    "A"
   ],
   "every": 30,
   "until": {
    "mode": 4
   },
   "timeout": 1200
  },
  {
   "comment": "player count (mode 4): wait for its menu (state 3) with every GBA counted as connected",
   "wait": {
    "lbl_8053AD98->field_0x4->field_0x1d4": 3,
    "lbl_8053AD98->field_0x4->field_0x1d0": 2
   },
   "timeout": 1200
  },
  {
   "comment": "DOWN until the cursor is on the 2-player game",
   "press": [
    "DOWN"
   ],
   "every": 20,
   "until": {
    "lbl_8053AD98->field_0x4->field_0x1bc": 1
   },
   "timeout": 600
  },
  {
   "comment": "A on the 2-player game and what follows until the stage is chosen (8-3, the opening)",
   "press": [
    "A"
   ],
   "every": 30,
   "until": {
    "stage": 8,
    "level": 3
   },
   "timeout": 1500
  },
  {
   "comment": "enter stage 1-0 instead of the opening, as stage_1_0.json does",
